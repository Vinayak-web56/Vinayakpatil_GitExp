
import multiprocessing
import time
import random


def access_resource(process_id, semaphore):
    """Simulates a worker process accessing a shared resource."""

    print(f"[Process {process_id}] is waiting to access the resource...")

    semaphore.acquire()

    try:
        print(f"[Process {process_id}] HAS ACCESSED the resource.")

        duration = random.uniform(1.5, 2.5)
        time.sleep(duration)

    finally:
        print(f"[Process {process_id}] is releasing the resource and leaving.")
        semaphore.release()


if __name__ == '__main__':

    max_connections = 2

    resource_semaphore = multiprocessing.Semaphore(max_connections)

    processes = []

    print(
        f"--- Starting Simulation "
        f"(Max allowed concurrent processes: {max_connections}) ---\n",
        flush=True
    )

    for i in range(1, 6):

        p = multiprocessing.Process(
            target=access_resource,
            args=(i, resource_semaphore)
        )

        processes.append(p)
        p.start()

        time.sleep(0.2)

    for p in processes:
        p.join()

    print(
        "\n--- Simulation Complete. "
        "All processes have finished safely. ---"
    )
